# Copy to .env.local for local development only.
# Vite dev server proxies /bookings to http://localhost:8080, so the local API base URL can be empty.
VITE_API_BASE_URL=

# For the Render staging STATIC SITE, set this in Render Environment BEFORE building:
# VITE_API_BASE_URL=https://vip-transfer-dalaman-api-test.onrender.com
# VITE_API_BASE_URL is a public build-time variable, NOT a secret.
# The backend must separately allow the frontend origin through FRONTEND_ORIGIN.

# Brand and domain remain unset until approved. Do not use Render staging URL as a canonical SEO origin.
VITE_SITE_NAME=
VITE_SITE_URL=

# Set the real business WhatsApp number in international digits, e.g. 905xxxxxxxxx.
# If unset, change/cancel links use email instead; never use the temporary phone placeholder.
VITE_WHATSAPP_NUMBER=
